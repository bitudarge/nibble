# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed. See src/lib/supabase/client.ts for how these are used.

# Supabase project URL — find it in Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=

# Supabase "anon" / "public" key — safe to expose in client code (it's the
# key browsers use), but still shouldn't be committed. Find it next to the URL
# above. NEVER put the "service_role" key here or anywhere in this app.
VITE_SUPABASE_ANON_KEY=

# Google Books API key — optional. Book pages work without one (Google
# allows a modest number of unauthenticated requests), but a key makes
# lookups reliable at real usage. See CLAUDE.md's "Refinement phase"
# section for exactly how to create one.
VITE_GOOGLE_BOOKS_API_KEY=
